# ── Agent LLM (runs locally via Ollama) ──
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# ── VectorAgent embedding model (sentence-transformers, downloaded from HuggingFace) ──
# Default: BAAI/bge-large-en-v1.5 (~1.3 GB). Swap for a lighter model if needed.
# VECTOR_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ── Cognee config ──
LLM_API_KEY=ollama
LLM_PROVIDER=ollama

# ── DeepEval Judge ──
# Pick ONE judge backend. Gemini Flash is the best free option.
#
# Option A: Gemini (recommended — free tier, great quality)
GOOGLE_API_KEY=your-gemini-api-key
DEEPEVAL_JUDGE=gemini
DEEPEVAL_JUDGE_MODEL=gemini-2.5-flash
#
# Option B: Ollama (fully offline, lower judge quality)
# DEEPEVAL_JUDGE=ollama
# DEEPEVAL_JUDGE_MODEL=llama3.1:8b
#
# Option C: OpenAI (best quality, costs money)
# OPENAI_API_KEY=sk-...
# DEEPEVAL_JUDGE=openai
# DEEPEVAL_JUDGE_MODEL=gpt-4o-mini
